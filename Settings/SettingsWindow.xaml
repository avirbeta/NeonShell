<Window x:Class="NeonShell.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Параметры Neon" Width="860" Height="640" MinWidth="760" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        WindowStyle="ToolWindow" Background="#FF0A0C14" ShowInTaskbar="True"
        Loaded="OnLoaded">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Навигация -->
        <Border Grid.Column="0" BorderBrush="#FF1E2433" BorderThickness="0,0,1,0" Background="#FF0D1018">
            <ListBox x:Name="NavList" Margin="8" SelectionChanged="OnNavChanged" Background="Transparent">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Glyph}" FontFamily="{DynamicResource IconFont}" FontSize="14"
                                       Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Width="28"/>
                            <TextBlock Text="{Binding Title}" FontSize="13.5" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Страницы -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="26,20">
                <!-- ===== ВНЕШНИЙ ВИД ===== -->
                <StackPanel x:Name="PageAppearance">
                    <TextBlock Text="ВНЕШНИЙ ВИД" Style="{StaticResource SectionTitle}" FontSize="15"/>
                    <TextBlock Text="Неоновая схема" FontSize="13.5" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,12,0,0"/>
                    <WrapPanel x:Name="SchemePanel" Margin="0,10,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <CheckBox x:Name="AnimationsChk" Style="{StaticResource Switch}" VerticalAlignment="Center"
                                  Checked="OnVisualChanged" Unchecked="OnVisualChanged"/>
                        <TextBlock Text="Плавные неоновые анимации" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <!-- ===== ОБОИ ===== -->
                <StackPanel x:Name="PageWallpaper" Visibility="Collapsed">
                    <TextBlock Text="ОБОИ" Style="{StaticResource SectionTitle}" FontSize="15"/>
                    <WrapPanel x:Name="WallpaperPanel" Margin="0,12,0,0"/>
                    <Button Content="Своё изображение..." HorizontalAlignment="Left" Margin="0,12,0,0" Click="OnBrowseWallpaper"/>
                </StackPanel>

                <!-- ===== РАБОЧИЙ СТОЛ ===== -->
                <StackPanel x:Name="PageDesktop" Visibility="Collapsed">
                    <TextBlock Text="РАБОЧИЙ СТОЛ" Style="{StaticResource SectionTitle}" FontSize="15"/>
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Размер значков" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <Slider x:Name="IconSizeSlider" Grid.Column="1" Style="{StaticResource NeonSlider}" Minimum="48" Maximum="96"
                                ValueChanged="OnSliderChanged"/>
                    </Grid>
                    <TextBlock Text="Значки на рабочем столе" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,16,0,0"/>
                    <WrapPanel Margin="0,8,0,0">
                        <CheckBox x:Name="IconGamesChk" Content="Игры" Margin="0,0,18,8" Checked="OnBuiltinChanged" Unchecked="OnBuiltinChanged"/>
                        <CheckBox x:Name="IconRecycleChk" Content="Корзина" Margin="0,0,18,8" Checked="OnBuiltinChanged" Unchecked="OnBuiltinChanged"/>
                        <CheckBox x:Name="IconSettingsChk" Content="Параметры Neon" Margin="0,0,18,8" Checked="OnBuiltinChanged" Unchecked="OnBuiltinChanged"/>
                        <CheckBox x:Name="IconExitChk" Content="Выйти в Windows" Margin="0,0,18,8" Checked="OnBuiltinChanged" Unchecked="OnBuiltinChanged"/>
                    </WrapPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Сбросить расположение значков" Click="OnResetPositions"/>
                        <Button Content="Открыть папку рабочего стола" Margin="10,0,0,0" Click="OnOpenDesktopFolder"/>
                    </StackPanel>
                </StackPanel>

                <!-- ===== ПАНЕЛЬ ЗАДАЧ ===== -->
                <StackPanel x:Name="PageTaskbar" Visibility="Collapsed">
                    <TextBlock Text="ПАНЕЛЬ ЗАДАЧ" Style="{StaticResource SectionTitle}" FontSize="15"/>
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Высота" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <Slider x:Name="TaskbarHeightSlider" Grid.Column="1" Style="{StaticResource NeonSlider}" Minimum="40" Maximum="80"
                                ValueChanged="OnSliderChanged"/>
                    </Grid>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Прозрачность" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <Slider x:Name="OpacitySlider" Grid.Column="1" Style="{StaticResource NeonSlider}" Minimum="30" Maximum="100"
                                ValueChanged="OnSliderChanged"/>
                    </Grid>
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Положение" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <ComboBox x:Name="PositionBox" Grid.Column="1" SelectionChanged="OnPositionChanged">
                            <ComboBoxItem Content="Снизу" Tag="Bottom"/>
                            <ComboBoxItem Content="Сверху" Tag="Top"/>
                        </ComboBox>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <CheckBox x:Name="AutoHideChk" Style="{StaticResource Switch}" VerticalAlignment="Center"
                                  Checked="OnTaskbarChanged" Unchecked="OnTaskbarChanged"/>
                        <TextBlock Text="Автоматически скрывать панель" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <CheckBox x:Name="SysTrayChk" Style="{StaticResource Switch}" VerticalAlignment="Center"
                                  Checked="OnSysTrayChanged" Unchecked="OnSysTrayChanged"/>
                        <StackPanel Margin="12,0,0,0">
                            <TextBlock Text="Скрывать системную панель Windows" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Windows-оболочка полностью скрывается; восстановится при выходе из Neon."
                                       FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- ===== УВЕДОМЛЕНИЯ ===== -->
                <StackPanel x:Name="PageNotifications" Visibility="Collapsed">
                    <TextBlock Text="УВЕДОМЛЕНИЯ" Style="{StaticResource SectionTitle}" FontSize="15"/>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <CheckBox x:Name="NotifEnabledChk" Style="{StaticResource Switch}" VerticalAlignment="Center"
                                  Checked="OnNotifChanged" Unchecked="OnNotifChanged"/>
                        <TextBlock Text="Показывать уведомления Neon" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Длительность (сек)" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <Slider x:Name="NotifDurationSlider" Grid.Column="1" Style="{StaticResource NeonSlider}" Minimum="3" Maximum="15"
                                ValueChanged="OnNotifChanged"/>
                    </Grid>
                    <Button Content="Очистить историю уведомлений" HorizontalAlignment="Left" Margin="0,14,0,0" Click="OnClearNotifications"/>
                </StackPanel>

                <!-- ===== ИГРЫ ===== -->
                <StackPanel x:Name="PageGames" Visibility="Collapsed">
                    <TextBlock Text="ИГРЫ" Style="{StaticResource SectionTitle}" FontSize="15"/>
                    <TextBlock Text="Игры находятся в меню Neon (вкладка «Игры»). Поиск: Steam, Epic Games и добавленные вручную."
                               FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                               Margin="0,12,0,0" MaxWidth="520"/>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Content="Пересканировать библиотеку" Click="OnRescanGames"/>
                        <Button Content="Вернуть скрытые игры" Margin="10,0,0,0" Click="OnRestoreGames"/>
                    </StackPanel>
                </StackPanel>

                <!-- ===== ЗВУК ===== -->
                <StackPanel x:Name="PageSound" Visibility="Collapsed">
                    <TextBlock Text="ЗВУК" Style="{StaticResource SectionTitle}" FontSize="15"/>
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Громкость" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <Slider x:Name="SoundVolumeSlider" Grid.Column="1" Style="{StaticResource NeonSlider}" Minimum="0" Maximum="100"
                                ValueChanged="OnSoundVolumeChanged"/>
                    </Grid>
                    <TextBlock x:Name="SoundPercentText" Text="100%" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}" Margin="0,8,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <CheckBox x:Name="SoundMuteChk" Style="{StaticResource Switch}" VerticalAlignment="Center"
                                  Checked="OnSoundMuteChanged" Unchecked="OnSoundMuteChanged"/>
                        <TextBlock Text="Без звука" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Content="Открыть микшер Windows" HorizontalAlignment="Left" Margin="0,18,0,0" Click="OnOpenMixer"/>
                </StackPanel>

                <!-- ===== БАТАРЕЯ ===== -->
                <StackPanel x:Name="PageBattery" Visibility="Collapsed">
                    <TextBlock Text="БАТАРЕЯ" Style="{StaticResource SectionTitle}" FontSize="15"/>
                    <Border Style="{StaticResource CardBorder}" Padding="16,14" Margin="0,14,0,0">
                        <Grid>
                            <StackPanel>
                                <TextBlock x:Name="BatteryPercentText" Text="—" FontSize="34" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentBrush}"/>
                                <TextBlock x:Name="BatteryStatusText" Text="" FontSize="13"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="BatteryGlyphText" Text="&#xE850;" FontFamily="{DynamicResource IconFont}"
                                       FontSize="44" Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <TextBlock Text="Режим энергопотребления" FontSize="13.5" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,18,0,0"/>
                    <ComboBox x:Name="PlanBox" Width="340" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                    <Button Content="Применить режим" HorizontalAlignment="Left" Margin="0,10,0,0" Click="OnApplyPlan"/>
                    <TextBlock x:Name="BatteryHintText" Text="" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,14,0,0" TextWrapping="Wrap" MaxWidth="520"/>
                </StackPanel>

                <!-- ===== WI-FI ===== -->
                <StackPanel x:Name="PageWifi" Visibility="Collapsed">
                    <TextBlock Text="WI-FI" Style="{StaticResource SectionTitle}" FontSize="15"/>
                    <Grid Margin="0,12,0,0">
                        <TextBlock x:Name="WifiStatusText" Text="Поиск сетей..." FontSize="13"
                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <Button Content="Обновить" HorizontalAlignment="Right" Padding="14,7" FontSize="12.5" Click="OnWifiRefresh"/>
                    </Grid>
                    <TextBlock Text="Доступные сети (клик — подключиться)" FontSize="11.5"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,10,0,4"/>
                    <ListBox x:Name="NetworksList" Height="190" SelectionChanged="OnNetworkSelected" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding SignalText}" FontSize="13" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Width="54"/>
                                    <TextBlock Text="{Binding Ssid}" FontSize="13.5" FontWeight="SemiBold"
                                               VerticalAlignment="Center" Width="180" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="&#xE72E;" FontFamily="{DynamicResource IconFont}" FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                                               ToolTip="{Binding AuthName}"
                                               Visibility="{Binding Secure, Converter={StaticResource BoolToVis}}"/>
                                    <TextBlock Text="&#xE718;" FontFamily="{DynamicResource IconFont}" FontSize="12"
                                               Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="8,0,0,0"
                                               ToolTip="Сохранена"
                                               Visibility="{Binding IsSaved, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="Сохранённые сети" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,12,0,4"/>
                    <ListBox x:Name="SavedList" Height="110" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <TextBlock Text="{Binding}" FontSize="13" VerticalAlignment="Center"/>
                                    <Button Content="Забыть" FontSize="11.5" Padding="10,4" HorizontalAlignment="Right"
                                            Tag="{Binding}" Click="OnForgetProfile"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Content="Отключиться от текущей сети" HorizontalAlignment="Left" Margin="0,12,0,0" Click="OnWifiDisconnect"/>
                </StackPanel>

                <!-- ===== УЧЁБА ===== -->
                <StackPanel x:Name="PageStudy" Visibility="Collapsed">
                    <TextBlock Text="ВРЕМЯ УЧЁБЫ" Style="{StaticResource SectionTitle}" FontSize="15"/>
                    <Border Style="{StaticResource CardBorder}" Padding="16,14" Margin="0,14,0,0">
                        <Grid>
                            <StackPanel>
                                <TextBlock x:Name="StudyStatusText" Text="" FontSize="17" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="Когда действует режим учёбы, запуск ЛЮБЫХ игр (Steam, Epic, добавленных вручную) полностью заблокирован."
                                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                                           MaxWidth="480" Margin="0,6,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="StudyGlyphText" Text="&#xE72E;" FontFamily="{DynamicResource IconFont}"
                                       FontSize="40" Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <CheckBox x:Name="StudyNowChk" Style="{StaticResource Switch}" VerticalAlignment="Center"
                                  Checked="OnStudyNowChanged" Unchecked="OnStudyNowChanged"/>
                        <TextBlock Text="Включить режим учёбы прямо сейчас" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <CheckBox x:Name="ScheduleChk" Style="{StaticResource Switch}" VerticalAlignment="Center"
                                  Checked="OnScheduleChanged" Unchecked="OnScheduleChanged"/>
                        <TextBlock Text="Блокировать игры по расписанию (каждый день)" FontSize="13"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <TextBlock Text="С" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <TextBox x:Name="StudyStartBox" Width="70" Margin="8,0,0,0" TextAlignment="Center" ToolTip="ЧЧ:ММ"/>
                        <TextBlock Text="по" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="14,0,0,0"/>
                        <TextBox x:Name="StudyEndBox" Width="70" Margin="8,0,0,0" TextAlignment="Center" ToolTip="ЧЧ:ММ"/>
                        <Button Content="Применить" Margin="14,0,0,0" Click="OnApplySchedule"/>
                    </StackPanel>

                    <TextBlock Text="В указанный период игры не запускаются вообще. Интервал может переходить через полночь (например, 22:00 — 07:00)."
                               FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,12,0,0"
                               TextWrapping="Wrap" MaxWidth="520"/>
                </StackPanel>

                <!-- ===== СИСТЕМА ===== -->
                <StackPanel x:Name="PageSystem" Visibility="Collapsed">
                    <TextBlock Text="СИСТЕМА" Style="{StaticResource SectionTitle}" FontSize="15"/>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <CheckBox x:Name="AutostartChk" Style="{StaticResource Switch}" VerticalAlignment="Center"
                                  Checked="OnAutostartChanged" Unchecked="OnAutostartChanged"/>
                        <StackPanel Margin="12,0,0,0">
                            <TextBlock Text="Запускать Neon Shell при входе в Windows" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="При повторяющихся сбоях автозапуск отключается автоматически."
                                       FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                        <Button Content="Перезапустить в безопасном режиме" Click="OnSafeMode"/>
                        <Button Content="Выйти в Windows" Margin="10,0,0,0" Click="OnExitWindows"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Открыть журналы" Click="OnOpenLogs"/>
                        <Button Content="Сбросить настройки" Margin="10,0,0,0" Click="OnResetAll"/>
                    </StackPanel>

                    <Border Height="1" Background="#FF1E2433" Margin="0,24"/>

                    <TextBlock Text="Neon Shell 1.0 · Vizor" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="Неоновая игровая оболочка Windows 10. Стандартный рабочий стол скрывается обратимо и восстанавливается при выходе. Все данные хранятся локально."
                               FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
